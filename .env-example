# Local development configuration. Copy to .env and replace secrets before use.

APP_ENV=development
APP_NAME=harness-memory
LOG_LEVEL=INFO

# PostgreSQL from docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://harness_memory:harness_memory@localhost:5432/harness_memory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=harness_memory
POSTGRES_USER=harness_memory
POSTGRES_PASSWORD=harness_memory

# Administrative bearer token for API governance routes. Replace before use.
API_ADMIN_TOKEN=replace-with-a-long-random-secret

# FastMCP HTTP server.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_TRANSPORT=http

# Use API-issued database tokens. Set jwt only for an external identity provider.
MCP_AUTH_MODE=database

# Optional telemetry.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=harness-memory
OTEL_EXPORTER_OTLP_ENDPOINT=
